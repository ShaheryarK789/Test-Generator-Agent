{
  "project": "Leave Management Portal",
  "sourceDocuments": ["samples/sample-requirements.md"],
  "requirements": [
    {"id": "FR-1.1", "description": "Login with email and password"},
    {"id": "FR-1.2", "description": "Password 8-20 chars, 1 uppercase, 1 digit, 1 special"},
    {"id": "FR-1.3", "description": "Lock account 15 min after 5 consecutive failed attempts"},
    {"id": "FR-2.1", "description": "Apply for Annual, Sick or Unpaid leave"},
    {"id": "FR-2.2", "description": "Start date not in past; end date >= start date"},
    {"id": "FR-2.3", "description": "Request length 1-30 days"},
    {"id": "FR-2.4", "description": "Reason optional, max 250 characters"},
    {"id": "FR-2.5", "description": "Annual leave cannot exceed remaining balance (default 20)"},
    {"id": "FR-3.1", "description": "Managers approve/reject direct reports' pending requests only"},
    {"id": "FR-3.2", "description": "Rejection requires comment, min 10 characters"},
    {"id": "FR-3.3", "description": "Email notification on approval/rejection"},
    {"id": "FR-4", "description": "Role & permission matrix"},
    {"id": "FR-5.1", "description": "POST /api/v1/leaves creates request, 201 + leaveId"},
    {"id": "FR-5.2", "description": "GET /api/v1/leaves/{id}, 404 if not found"},
    {"id": "FR-5.3", "description": "PATCH /api/v1/leaves/{id}/status, Managers/HR only"}
  ],
  "testCases": [
    {"id": "TC-001", "module": "Login", "title": "Login with valid email and password", "category": "Positive", "criticality": "High", "requirementRef": ["FR-1.1"], "preconditions": "Active user exists", "testData": "user@corp.com / Valid@123", "steps": ["Open login page", "Enter valid email and password", "Click Login"], "expected": "User lands on dashboard; session created"},
    {"id": "TC-002", "module": "Login", "title": "Reject login with wrong password", "category": "Negative", "criticality": "High", "requirementRef": ["FR-1.1"], "preconditions": "Active user exists", "testData": "user@corp.com / Wrong@123", "steps": ["Enter valid email and wrong password", "Click Login"], "expected": "Generic 'Invalid email or password' error; no session; failed-attempt counter +1"},
    {"id": "TC-003", "module": "Login", "title": "Reject login with unregistered email", "category": "Negative", "criticality": "Medium", "requirementRef": ["FR-1.1"], "testData": "nobody@corp.com", "steps": ["Enter unregistered email and any password", "Click Login"], "expected": "Same generic error as wrong password (no user enumeration)"},
    {"id": "TC-004", "module": "Login", "title": "Reject password missing uppercase/digit/special", "category": "Negative", "criticality": "Medium", "requirementRef": ["FR-1.2"], "testData": "valid@1234 ; Valid@abcd ; Valid1234", "steps": ["Set/enter each password variant", "Submit"], "expected": "Each rejected with a policy message naming the missing rule"},
    {"id": "TC-005", "module": "Login", "title": "Password length boundary 7/8/9 characters", "category": "Boundary", "criticality": "Medium", "requirementRef": ["FR-1.2"], "testData": "Va@1234 (7) ; Va@12345 (8) ; Va@123456 (9)", "steps": ["Submit each password"], "expected": "7 rejected; 8 and 9 accepted"},
    {"id": "TC-006", "module": "Login", "title": "Password length boundary 19/20/21 characters", "category": "Boundary", "criticality": "Medium", "requirementRef": ["FR-1.2"], "testData": "19, 20 and 21-char compliant passwords", "steps": ["Submit each password"], "expected": "19 and 20 accepted; 21 rejected"},
    {"id": "TC-007", "module": "Login", "title": "Account locks after 5th consecutive failure", "category": "Boundary", "criticality": "High", "requirementRef": ["FR-1.3"], "steps": ["Enter wrong password 4 times", "Verify account status", "Enter wrong password a 5th time", "Enter the correct password"], "expected": "After 4 failures account still active; after the 5th failure account is locked; correct password rejected with 'Account locked for 15 minutes' message"},
    {"id": "TC-008", "module": "Login", "title": "Lock expires after 15 minutes", "category": "Boundary", "criticality": "High", "requirementRef": ["FR-1.3"], "preconditions": "Account locked at T0", "steps": ["Attempt login at T0+14:59", "Attempt login at T0+15:00"], "expected": "14:59 rejected (locked); 15:00 succeeds with correct password"},
    {"id": "TC-009", "module": "Login", "title": "Successful login resets failure counter", "category": "Corner", "criticality": "Medium", "requirementRef": ["FR-1.3"], "steps": ["Fail 4 times", "Log in successfully", "Log out and fail 4 more times"], "expected": "Account not locked (counter reset after success)"},
    {"id": "TC-010", "module": "Login", "title": "Email with leading/trailing spaces and mixed case", "category": "Corner", "criticality": "Low", "requirementRef": ["FR-1.1"], "testData": "'  User@Corp.COM '", "steps": ["Enter padded mixed-case email + valid password", "Login"], "expected": "Email trimmed and matched case-insensitively; login succeeds"},

    {"id": "TC-011", "module": "Apply Leave", "title": "Apply Annual leave within balance", "category": "Positive", "criticality": "High", "requirementRef": ["FR-2.1", "FR-2.5"], "preconditions": "Employee with 20 days balance", "testData": "Annual, tomorrow to +4 days (5 days)", "steps": ["Open Apply Leave", "Select Annual and dates", "Submit"], "expected": "Request created as Pending; balance shows 20 (15 after approval)"},
    {"id": "TC-012", "module": "Apply Leave", "title": "Apply Sick and Unpaid leave", "category": "Positive", "criticality": "High", "requirementRef": ["FR-2.1"], "steps": ["Submit Sick leave request", "Submit Unpaid leave request"], "expected": "Both created as Pending; Annual balance unchanged"},
    {"id": "TC-013", "module": "Apply Leave", "title": "Reject start date in the past", "category": "Negative", "criticality": "High", "requirementRef": ["FR-2.2"], "testData": "Start = yesterday", "steps": ["Pick yesterday as start", "Submit"], "expected": "Validation error 'Start date cannot be in the past'; nothing saved"},
    {"id": "TC-014", "module": "Apply Leave", "title": "Reject end date before start date", "category": "Negative", "criticality": "High", "requirementRef": ["FR-2.2"], "testData": "Start = +5, End = +3", "steps": ["Enter dates", "Submit"], "expected": "Validation error; nothing saved"},
    {"id": "TC-015", "module": "Apply Leave", "title": "Start date today and end = start accepted", "category": "Boundary", "criticality": "Medium", "requirementRef": ["FR-2.2", "FR-2.3"], "testData": "Start = End = today", "steps": ["Submit 1-day request for today"], "expected": "Accepted as 1-day request"},
    {"id": "TC-016", "module": "Apply Leave", "title": "Request length boundary 29/30/31 days", "category": "Boundary", "criticality": "High", "requirementRef": ["FR-2.3"], "testData": "Unpaid leave of 29, 30, 31 days", "steps": ["Submit each request"], "expected": "29 and 30 accepted; 31 rejected with max-length message"},
    {"id": "TC-017", "module": "Apply Leave", "title": "Reason length boundary 0/250/251", "category": "Boundary", "criticality": "Low", "requirementRef": ["FR-2.4"], "testData": "empty ; 250 chars ; 251 chars", "steps": ["Submit with each reason"], "expected": "Empty and 250 accepted; 251 blocked (counter/validation)"},
    {"id": "TC-018", "module": "Apply Leave", "title": "Annual leave balance boundary", "category": "Boundary", "criticality": "High", "requirementRef": ["FR-2.5"], "preconditions": "Balance = 10 days", "testData": "Annual 10 days ; Annual 11 days", "steps": ["Submit 10-day request", "Submit 11-day request (fresh user)"], "expected": "10 accepted; 11 rejected 'Insufficient balance'"},
    {"id": "TC-019", "module": "Apply Leave", "title": "Overlapping pending requests", "category": "Corner", "criticality": "Medium", "requirementRef": ["FR-2.1"], "steps": ["Submit request for +5..+7", "Submit second request +6..+8"], "expected": "Second request blocked as overlapping (see open question)"},
    {"id": "TC-020", "module": "Apply Leave", "title": "Double-click Submit creates one request", "category": "Corner", "criticality": "Medium", "requirementRef": ["FR-2.1"], "steps": ["Fill valid request", "Double-click Submit quickly"], "expected": "Exactly one request created"},
    {"id": "TC-021", "module": "Apply Leave", "title": "Reason with emoji, unicode and HTML", "category": "Corner", "criticality": "Low", "requirementRef": ["FR-2.4"], "testData": "'Família 🎉 <script>alert(1)</script>'", "steps": ["Submit with reason", "View request"], "expected": "Text stored and shown literally; no script executes"},

    {"id": "TC-022", "module": "Approvals", "title": "Manager approves direct report's request", "category": "Positive", "criticality": "High", "requirementRef": ["FR-3.1", "FR-3.3"], "preconditions": "Pending request from direct report", "steps": ["Open Team Requests", "Approve request"], "expected": "Status Approved; balance deducted; employee receives approval email"},
    {"id": "TC-023", "module": "Approvals", "title": "Manager rejects with valid comment", "category": "Positive", "criticality": "High", "requirementRef": ["FR-3.2", "FR-3.3"], "testData": "Comment: 'Team coverage needed'", "steps": ["Reject with comment"], "expected": "Status Rejected; comment saved; rejection email sent with comment"},
    {"id": "TC-024", "module": "Approvals", "title": "Reject without comment blocked", "category": "Negative", "criticality": "High", "requirementRef": ["FR-3.2"], "steps": ["Click Reject with empty comment"], "expected": "Validation error; status stays Pending"},
    {"id": "TC-025", "module": "Approvals", "title": "Rejection comment boundary 9/10 chars", "category": "Boundary", "criticality": "Medium", "requirementRef": ["FR-3.2"], "testData": "'123456789' ; '1234567890'", "steps": ["Reject with 9-char comment", "Reject with 10-char comment"], "expected": "9 rejected; 10 accepted"},
    {"id": "TC-026", "module": "Approvals", "title": "Comment of 10 spaces not accepted", "category": "Corner", "criticality": "Low", "requirementRef": ["FR-3.2"], "testData": "10 spaces", "steps": ["Reject with whitespace comment"], "expected": "Treated as empty; validation error"},
    {"id": "TC-027", "module": "Approvals", "title": "Cannot act on already processed request", "category": "Corner", "criticality": "Medium", "requirementRef": ["FR-3.1"], "steps": ["Open request in two tabs", "Approve in tab 1", "Reject in tab 2"], "expected": "Tab 2 action fails with 'already processed'; status remains Approved"}
  ],
  "apiTestCases": [
    {"id": "API-001", "module": "Leaves API", "title": "Create leave with valid JWT returns 201", "method": "POST", "endpoint": "/api/v1/leaves", "category": "Positive", "criticality": "High", "requirementRef": ["FR-5.1"], "headers": {"Authorization": "Bearer <employee JWT>", "Content-Type": "application/json"}, "requestBody": {"type": "ANNUAL", "startDate": "<tomorrow>", "endDate": "<tomorrow+2>", "reason": "Trip"}, "steps": ["Send request", "GET the returned leaveId"], "expectedStatus": 201, "expectedResponse": "Body contains leaveId; GET returns same data with status PENDING"},
    {"id": "API-002", "module": "Leaves API", "title": "Create leave without JWT returns 401", "method": "POST", "endpoint": "/api/v1/leaves", "category": "Negative", "criticality": "High", "requirementRef": ["FR-5.1"], "requestBody": {"type": "ANNUAL"}, "expectedStatus": 401, "expectedResponse": "Error body; no record created"},
    {"id": "API-003", "module": "Leaves API", "title": "Create leave with expired JWT returns 401", "method": "POST", "endpoint": "/api/v1/leaves", "category": "Corner", "criticality": "High", "requirementRef": ["FR-5.1"], "headers": {"Authorization": "Bearer <expired JWT>"}, "expectedStatus": 401, "expectedResponse": "Token expired error"},
    {"id": "API-004", "module": "Leaves API", "title": "Missing required field returns 400", "method": "POST", "endpoint": "/api/v1/leaves", "category": "Negative", "criticality": "Medium", "requirementRef": ["FR-5.1", "FR-2.2"], "requestBody": {"type": "SICK", "endDate": "<tomorrow>"}, "expectedStatus": 400, "expectedResponse": "Validation error naming startDate"},
    {"id": "API-005", "module": "Leaves API", "title": "Invalid leave type enum returns 400", "method": "POST", "endpoint": "/api/v1/leaves", "category": "Negative", "criticality": "Medium", "requirementRef": ["FR-5.1", "FR-2.1"], "requestBody": {"type": "VACATION"}, "expectedStatus": 400, "expectedResponse": "Allowed values listed"},
    {"id": "API-006", "module": "Leaves API", "title": "31-day request rejected by API", "method": "POST", "endpoint": "/api/v1/leaves", "category": "Boundary", "criticality": "High", "requirementRef": ["FR-2.3", "FR-5.1"], "requestBody": {"type": "UNPAID", "startDate": "<D>", "endDate": "<D+30>"}, "expectedStatus": 400, "expectedResponse": "Max 30 days error (server-side validation, not only UI)"},
    {"id": "API-007", "module": "Leaves API", "title": "Get existing leave returns 200", "method": "GET", "endpoint": "/api/v1/leaves/{id}", "category": "Positive", "criticality": "High", "requirementRef": ["FR-5.2"], "expectedStatus": 200, "expectedResponse": "Schema: leaveId, type, startDate, endDate, status, reason"},
    {"id": "API-008", "module": "Leaves API", "title": "Get unknown leave returns 404", "method": "GET", "endpoint": "/api/v1/leaves/{id}", "category": "Negative", "criticality": "Medium", "requirementRef": ["FR-5.2"], "testData": "id = 99999999", "expectedStatus": 404, "expectedResponse": "Not found error body"},
    {"id": "API-009", "module": "Leaves API", "title": "Employee cannot read another employee's leave (IDOR)", "method": "GET", "endpoint": "/api/v1/leaves/{id}", "category": "Corner", "criticality": "High", "requirementRef": ["FR-5.2", "FR-4"], "preconditions": "JWT of Employee A; leave id belongs to Employee B", "expectedStatus": 403, "expectedResponse": "Forbidden (or 404); no data leaked"},
    {"id": "API-010", "module": "Leaves API", "title": "Manager approves via PATCH returns 200", "method": "PATCH", "endpoint": "/api/v1/leaves/{id}/status", "category": "Positive", "criticality": "High", "requirementRef": ["FR-5.3"], "headers": {"Authorization": "Bearer <manager JWT>"}, "requestBody": {"status": "APPROVED"}, "expectedStatus": 200, "expectedResponse": "status=APPROVED"},
    {"id": "API-011", "module": "Leaves API", "title": "Employee PATCH status returns 403", "method": "PATCH", "endpoint": "/api/v1/leaves/{id}/status", "category": "Negative", "criticality": "High", "requirementRef": ["FR-5.3", "FR-4"], "headers": {"Authorization": "Bearer <employee JWT>"}, "requestBody": {"status": "APPROVED"}, "expectedStatus": 403, "expectedResponse": "Forbidden; status unchanged"},
    {"id": "API-012", "module": "Leaves API", "title": "REJECTED with 9-char comment returns 400", "method": "PATCH", "endpoint": "/api/v1/leaves/{id}/status", "category": "Boundary", "criticality": "Medium", "requirementRef": ["FR-5.3", "FR-3.2"], "requestBody": {"status": "REJECTED", "comment": "123456789"}, "expectedStatus": 400, "expectedResponse": "Comment min length error"}
  ],
  "roleTestCases": [
    {"id": "RBAC-001", "module": "Leave", "title": "Employee can apply for leave", "role": "Employee", "permission": "Apply for leave", "access": "Allowed", "category": "Positive", "criticality": "High", "requirementRef": ["FR-4"], "steps": ["Log in as Employee", "Submit leave request"], "expected": "Request created"},
    {"id": "RBAC-002", "module": "Leave", "title": "Employee cannot approve/reject leave", "role": "Employee", "permission": "Approve/reject team leave", "access": "Denied", "category": "Negative", "criticality": "High", "requirementRef": ["FR-4"], "steps": ["Log in as Employee", "Look for Team Requests menu", "Open approvals URL directly"], "expected": "Menu hidden; direct URL shows 403/access denied"},
    {"id": "RBAC-003", "module": "Leave", "title": "Employee cannot edit leave balances", "role": "Employee", "permission": "Edit leave balances", "access": "Denied", "category": "Negative", "criticality": "High", "requirementRef": ["FR-4"], "steps": ["Open balance admin URL as Employee"], "expected": "403; no change"},
    {"id": "RBAC-004", "module": "Leave", "title": "Manager approves own team's leave", "role": "Manager", "permission": "Approve/reject team leave", "access": "Allowed", "category": "Positive", "criticality": "High", "requirementRef": ["FR-4", "FR-3.1"], "steps": ["Log in as Manager", "Approve direct report's request"], "expected": "Approved"},
    {"id": "RBAC-005", "module": "Leave", "title": "Manager cannot approve non-direct report", "role": "Manager", "permission": "Approve/reject team leave", "access": "Denied", "category": "Negative", "criticality": "High", "requirementRef": ["FR-3.1", "FR-4"], "steps": ["Open other team's request URL", "Attempt approve via UI and API"], "expected": "Not visible; API returns 403"},
    {"id": "RBAC-006", "module": "Leave", "title": "Manager cannot edit leave balances", "role": "Manager", "permission": "Edit leave balances", "access": "Denied", "category": "Negative", "criticality": "High", "requirementRef": ["FR-4"], "steps": ["Open balance admin as Manager"], "expected": "403"},
    {"id": "RBAC-007", "module": "Leave", "title": "Manager views team-only leave list", "role": "Manager", "permission": "View all employees' leave", "access": "Allowed", "category": "Corner", "criticality": "High", "requirementRef": ["FR-4"], "steps": ["Open leave list as Manager", "Filter/search for non-team employee"], "expected": "Only direct reports shown; non-team employee not found"},
    {"id": "RBAC-008", "module": "Leave", "title": "Manager cannot approve own leave", "role": "Manager", "permission": "Approve/reject team leave", "access": "Denied", "category": "Corner", "criticality": "High", "requirementRef": ["FR-3.1"], "steps": ["Manager applies for leave", "Attempt to approve it"], "expected": "Not allowed; routed to their manager/HR"},
    {"id": "RBAC-009", "module": "Leave", "title": "HR Admin edits leave balance", "role": "HR Admin", "permission": "Edit leave balances", "access": "Allowed", "category": "Positive", "criticality": "High", "requirementRef": ["FR-4"], "steps": ["Change employee balance 20 -> 22"], "expected": "Saved; audit entry recorded"},
    {"id": "RBAC-010", "module": "Leave", "title": "HR Admin views all employees' leave", "role": "HR Admin", "permission": "View all employees' leave", "access": "Allowed", "category": "Positive", "criticality": "Medium", "requirementRef": ["FR-4"], "steps": ["Open leave list as HR Admin"], "expected": "All employees visible"},
    {"id": "RBAC-011", "module": "Leave", "title": "Role downgrade takes effect in active session", "role": "Manager", "permission": "Approve/reject team leave", "access": "Denied", "category": "Corner", "criticality": "High", "requirementRef": ["FR-4"], "steps": ["Manager logged in", "HR changes role to Employee", "Manager tries to approve"], "expected": "Action denied (next request at latest)"}
  ],
  "roleMatrix": {
    "roles": ["Employee", "Manager", "HR Admin"],
    "permissions": [
      {"name": "Apply for leave", "access": {"Employee": "Y", "Manager": "Y", "HR Admin": "Y"}},
      {"name": "Approve/reject team leave", "access": {"Employee": "N", "Manager": "Y", "HR Admin": "Y"}},
      {"name": "Edit leave balances", "access": {"Employee": "N", "Manager": "N", "HR Admin": "Y"}},
      {"name": "View all employees' leave", "access": {"Employee": "N", "Manager": "Team only", "HR Admin": "Y"}}
    ]
  },
  "assumptions": ["Days counted as calendar days (spec doesn't say working days)", "Lock window measured from the 5th failed attempt"],
  "openQuestions": ["Are overlapping leave requests allowed?", "Is the 30-day limit calendar or working days?", "Can a manager approve their own leave? Who approves a manager's leave?", "Can employees cancel a pending/approved request?"],
  "outOfScope": ["Performance and load testing", "Email template visual design"]
}
